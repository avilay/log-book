{
  "cli": {
    "version": ">= 12.4.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
      	"EXPO_PUBLIC_ENV": "dev",
        "EXPO_PUBLIC_SIM_DELAY": "false",
        "EXPO_PUBLIC_DATA_RESET_SCHEMA": "false",
        "EXPO_PUBLIC_DATA_DELETE": "true",
        "EXPO_PUBLIC_DATA_GEN": "true"

      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
      	"EXPO_PUBLIC_ENV": "prod",
        "EXPO_PUBLIC_SIM_DELAY": "false",
        "EXPO_PUBLIC_DATA_RESET_SCHEMA": "false",
        "EXPO_PUBLIC_DATA_DELETE": "false",
        "EXPO_PUBLIC_DATA_GEN": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6714371529"
      }
    }
  }
}
